################################################################################
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file to version control.
################################################################################

# TimescaleDB
POSTGRES_USER=quantuser
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=quantdb
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Airflow metadata DB (separate postgres, not TimescaleDB)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme_airflow_db
AIRFLOW_DB_NAME=airflow

# Airflow security keys
# Generate fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme_generate_with_fernet
AIRFLOW_SECRET_KEY=changeme_airflow_secret

# Airflow admin user (created automatically on first start)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=changeme_airflow_admin

# External API keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
APCA-API-KEY-ID=your_alpaca_api_key_id_here
APCA-API-SECRET-KEY=your_alpaca_api_secret_key_here
